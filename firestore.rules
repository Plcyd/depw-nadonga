rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'edgey3827@gmail.com'
      );
    }

    // Validation Blueprint: Ticket
    function isValidTicket(data) {
      return data.keys().hasAll([
          'ticketId', 'dateReceived', 'barangay', 'district', 'legislativeDistrict',
          'streetAddress', 'requestType', 'status', 'actionTaken', 'nextStep',
          'requesterName', 'requesterRole', 'description', 'latitude', 'longitude',
          'coordSource', 'coordVerified', 'priority', 'ownerId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ticketId', 'dateReceived', 'barangay', 'district', 'legislativeDistrict',
          'streetAddress', 'requestType', 'status', 'actionTaken', 'nextStep',
          'requesterName', 'requesterRole', 'description', 'latitude', 'longitude',
          'coordSource', 'coordVerified', 'priority', 'ownerId', 'createdAt', 'updatedAt'
        ])
        && data.ticketId is string && data.ticketId.size() >= 5 && data.ticketId.size() <= 32 && data.ticketId.matches('^DEO-202[0-9]-[0-9]{3,5}$')
        && data.dateReceived is string && data.dateReceived.size() >= 4 && data.dateReceived.size() <= 32
        && data.barangay is string && data.barangay.size() >= 2 && data.barangay.size() <= 100
        && data.district is string && data.district.size() >= 2 && data.district.size() <= 60
        && data.legislativeDistrict is string && data.legislativeDistrict.size() >= 2 && data.legislativeDistrict.size() <= 40
        && data.streetAddress is string && data.streetAddress.size() >= 2 && data.streetAddress.size() <= 200
        && data.requestType is string && data.requestType.size() <= 40 && data.requestType in ['Declogging', 'Desilting', 'Manhole Repair', 'Gutter Clearance', 'Drainage Inspection']
        && data.status is string && data.status.size() <= 40 && data.status in ['For Verification', 'Pending Evaluation', 'Returned for Clarification', 'Inspection Scheduled', 'Scheduled for Implementation', 'In Progress', 'Completed', 'Closed']
        && data.actionTaken is string && data.actionTaken.size() >= 2 && data.actionTaken.size() <= 300
        && data.nextStep is string && data.nextStep.size() >= 2 && data.nextStep.size() <= 300
        && data.requesterName is string && data.requesterName.size() >= 2 && data.requesterName.size() <= 120
        && data.requesterRole is string && data.requesterRole.size() >= 2 && data.requesterRole.size() <= 80
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 1500
        && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
        && data.coordSource is string && data.coordSource.size() >= 2 && data.coordSource.size() <= 60
        && data.coordVerified is bool
        && data.priority is string && data.priority.size() <= 30 && data.priority in ['Routine', 'Elevated', 'High Priority']
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: TicketHistoryEvent
    function isValidHistoryEvent(data) {
      return data.keys().hasAll([
          'ticketId', 'previousStatus', 'newStatus', 'actionTaken', 'actorUid', 'actorName', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ticketId', 'previousStatus', 'newStatus', 'actionTaken', 'actorUid', 'actorName', 'createdAt'
        ])
        && data.ticketId is string && data.ticketId.size() >= 5 && data.ticketId.size() <= 32 && data.ticketId.matches('^DEO-202[0-9]-[0-9]{3,5}$')
        && data.previousStatus is string && data.previousStatus.size() >= 2 && data.previousStatus.size() <= 40
        && data.newStatus is string && data.newStatus.size() >= 2 && data.newStatus.size() <= 40
        && data.actionTaken is string && data.actionTaken.size() >= 2 && data.actionTaken.size() <= 300
        && data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 && data.actorUid == request.auth.uid
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: AdminRecord
    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'role', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.role is string && data.role.size() <= 20 && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    // Collection: /tickets/{ticketId}
    match /tickets/{ticketId} {
      allow get: if isSignedIn() && isValidId(ticketId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser()
        && isValidId(ticketId)
        && isValidTicket(incoming())
        && incoming().ticketId == ticketId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(ticketId)
        && isValidTicket(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().ticketId == existing().ticketId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            existing().ownerId == request.auth.uid
            && existing().status != 'Closed'
            && (
              // Action 1: Status Transition
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'actionTaken', 'nextStep', 'updatedAt'])
              ||
              // Action 2: Field & Coordinate Edit
              incoming().diff(existing()).affectedKeys().hasOnly([
                'barangay', 'district', 'legislativeDistrict', 'streetAddress',
                'requestType', 'status', 'actionTaken', 'nextStep',
                'requesterName', 'requesterRole', 'description',
                'latitude', 'longitude', 'coordSource', 'coordVerified',
                'priority', 'updatedAt'
              ])
            )
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(ticketId)
        && (existing().ownerId == request.auth.uid || isAdmin());

      // Subcollection: /tickets/{ticketId}/history/{eventId}
      match /history/{eventId} {
        allow get: if isSignedIn()
          && isValidId(ticketId)
          && isValidId(eventId)
          && (
            get(/databases/$(database)/documents/tickets/$(ticketId)).data.ownerId == request.auth.uid
            || isAdmin()
          );

        allow list: if isSignedIn()
          && isValidId(ticketId)
          && (existing().actorUid == request.auth.uid || isAdmin());

        allow create: if isVerifiedUser()
          && isValidId(ticketId)
          && isValidId(eventId)
          && isValidHistoryEvent(incoming())
          && incoming().ticketId == ticketId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/tickets/$(ticketId))
          && (
            get(/databases/$(database)/documents/tickets/$(ticketId)).data.ownerId == request.auth.uid
            || isAdmin()
          );

        allow update, delete: if false;
      }
    }

    // Collection: /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if false;
      allow create: if isAdmin() && isValidId(adminId) && isValidAdminRecord(incoming()) && incoming().uid == adminId && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
